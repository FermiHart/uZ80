# build artefacts (Makefile builds out-of-tree into $HOME/.uz80 by default,
# but if anyone overrides BUILD= to point inside the tree, ignore these)
*.rel
*.lst
*.sym
*.lk
*.map
*.noi
*.ihx
*.img
*.rom
*.asm
*.rst
build/
data/

# screenshots saved by `make shot` / `make demo` if BUILD is in-tree
*.jpg
*.png
# ...but the curated gallery under docs/ is versioned on purpose
!docs/screenshots/*.jpg

# macOS
.DS_Store

# scratch dir for staging screenshots before curating into docs/
.gallery-tmp/
